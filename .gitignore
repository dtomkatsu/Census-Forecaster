# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.pytest_cache/
.coverage
htmlcov/
build/
dist/
!dashboard/dist/
.tox/

# Virtual envs
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store

# Caches written by the package at runtime
data/cache/
*.cache.json

# tax_modeler heavy data — fetched on demand via:
#   uv run python -m tax_modeler.scripts.fetch_dotax_soi
#   uv run python -m tax_modeler.scripts.fetch_irs_soi
data/tax_modeler/raw/
data/tax_modeler/external/
data/tax_modeler/processed/
!data/tax_modeler/raw/.gitkeep
!data/tax_modeler/external/.gitkeep
!data/tax_modeler/processed/.gitkeep

# Raw PUMS microdata (downloaded on demand from
# https://www2.census.gov/programs-surveys/acs/data/pums/2022/5-Year/)
# The zips only re-contain the CSV + README already in the same directory,
# so they are pure duplication. The CSVs are NOT redundant: PUMSDataLoader
# drops every row when it reads the parquet (ST is int64 there but the
# filter compares to the string '15'), so the CSV is the only working
# input for pums_2024_1yr/. Keep it tracked until that bug is fixed.
packages/data/raw/**/*.zip
packages/data/raw/**/*.pdf
packages/data/raw/pums/*.csv
packages/data/raw/pums/*.parquet

# Versioned forecast artifacts (caches + calibrated bases; rebuilt locally)
data/artifacts/

# Run outputs written by forecast_rxkids_2028.py — regenerable, not inputs
reports/**/spm_units.parquet

# Editor/backup leftovers and stray run logs
*.bak
*.log
